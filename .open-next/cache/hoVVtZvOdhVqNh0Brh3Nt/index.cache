{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"}},"html":"<!DOCTYPE html><html lang=\"th\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" href=\"/301.png\"/><link rel=\"preload\" as=\"image\" href=\"/Ph2.png\"/><link rel=\"preload\" as=\"image\" href=\"/mn3.png\"/><link rel=\"preload\" as=\"image\" href=\"/NT4.png\"/><link rel=\"preload\" as=\"image\" href=\"/TC5.png\"/><link rel=\"preload\" as=\"image\" href=\"/KS6.png\"/><link rel=\"preload\" as=\"image\" href=\"/Sc7.png\"/><link rel=\"preload\" as=\"image\" href=\"/org-chart1.png\"/><link rel=\"preload\" as=\"image\" href=\"/org-chart2.png\"/><link rel=\"preload\" as=\"image\" href=\"/org-chart3.png\"/><link rel=\"stylesheet\" href=\"/_next/static/css/5ed7e8e2458d6db6.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-616e068a201ad621.js\"/><script src=\"/_next/static/chunks/fd9d1056-87da80e0c187477b.js\" async=\"\"></script><script src=\"/_next/static/chunks/117-baab43fc83142998.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-9bd3bf9f44bc2fb2.js\" async=\"\"></script><script src=\"/_next/static/chunks/648-485abeac37f81ba6.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-bb9c253c1d841d1d.js\" async=\"\"></script><link rel=\"preload\" as=\"image\" href=\"/org-chart4.png\"/><title>IRM Extra - Property Management</title><meta name=\"description\" content=\"บริษัท ไอ อาร์ เอ็ม เอ็กซ์ตร้า จำกัด บริหารทรัพย์สินมืออาชีพ\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><header><nav class=\"navbar\"><a class=\"company-name\" href=\"/\">IRM <span>EXTRA</span></a><button class=\"menu-toggle\" aria-label=\"Toggle menu\">☰</button><div class=\"nav-menu\"><a href=\"/\">หน้าแรก</a><a href=\"/about\">เกี่ยวกับเรา</a><a href=\"/services\">บริการ</a><a href=\"/projects\">ผลงาน</a><a href=\"/contact\">ติดต่อเรา</a><a class=\"career-btn\" href=\"/jobs\">สมัครงาน</a></div></nav></header><main class=\"section-container\"><section class=\"hero hero-slider\" style=\"position:relative;overflow:hidden;aspect-ratio:4 / 5;max-height:500px;border-radius:10px;cursor:grab;user-select:none\"><div style=\"position:absolute;inset:0;background:#1e3a3a;display:flex;align-items:center;justify-content:center;opacity:1;transition:opacity 1.2s ease-in-out;pointer-events:none\"><img src=\"/301.png\" alt=\"\" style=\"width:100%;height:100%;object-fit:contain\"/></div><div style=\"position:absolute;inset:0;background:#1e3a3a;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 1.2s ease-in-out;pointer-events:none\"><img src=\"/Ph2.png\" alt=\"\" style=\"width:100%;height:100%;object-fit:contain\"/></div><div style=\"position:absolute;inset:0;background:#1e3a3a;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 1.2s ease-in-out;pointer-events:none\"><img src=\"/mn3.png\" alt=\"\" style=\"width:100%;height:100%;object-fit:contain\"/></div><div style=\"position:absolute;inset:0;background:#1e3a3a;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 1.2s ease-in-out;pointer-events:none\"><img src=\"/NT4.png\" alt=\"\" style=\"width:100%;height:100%;object-fit:contain\"/></div><div style=\"position:absolute;inset:0;background:#1e3a3a;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 1.2s ease-in-out;pointer-events:none\"><img src=\"/TC5.png\" alt=\"\" style=\"width:100%;height:100%;object-fit:contain\"/></div><div style=\"position:absolute;inset:0;background:#1e3a3a;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 1.2s ease-in-out;pointer-events:none\"><img src=\"/KS6.png\" alt=\"\" style=\"width:100%;height:100%;object-fit:contain\"/></div><div style=\"position:absolute;inset:0;background:#1e3a3a;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 1.2s ease-in-out;pointer-events:none\"><img src=\"/Sc7.png\" alt=\"\" style=\"width:100%;height:100%;object-fit:contain\"/></div><div style=\"position:absolute;inset:0;background:linear-gradient(135deg, #1e3a3a, #0f1f24);opacity:0;transition:opacity 1.2s ease-in-out;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#fff;padding:0 20px;pointer-events:none\"><h1>IRM Extra</h1><p style=\"max-width:600px\">บริษัท ไอ อาร์ เอ็ม เอ็กซ์ตร้า จำกัด (IRM Extra) บริษัทในเครือ IRM ให้บริการด้านบริหารทรัพย์สินโดยทีมงานมืออาชีพ ครอบคลุมพื้นที่ภาคอีสาน</p><a class=\"btn\" href=\"/jobs\">ร่วมงานกับเรา</a></div><button type=\"button\" aria-label=\"ก่อนหน้า\" style=\"position:absolute;top:50%;left:16px;transform:translateY(-50%);z-index:3;background:rgba(0,0,0,.35);color:#fff;border:none;width:40px;height:40px;border-radius:50%;font-size:24px;cursor:pointer\">‹</button><button type=\"button\" aria-label=\"ถัดไป\" style=\"position:absolute;top:50%;right:16px;transform:translateY(-50%);z-index:3;background:rgba(0,0,0,.35);color:#fff;border:none;width:40px;height:40px;border-radius:50%;font-size:24px;cursor:pointer\">›</button><div style=\"position:absolute;bottom:16px;left:50%;transform:translateX(-50%);z-index:3;display:flex;gap:8px\"><span style=\"width:9px;height:9px;border-radius:50%;background:#f5820a;cursor:pointer;transition:background .3s\"></span><span style=\"width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer;transition:background .3s\"></span><span style=\"width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer;transition:background .3s\"></span><span style=\"width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer;transition:background .3s\"></span><span style=\"width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer;transition:background .3s\"></span><span style=\"width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer;transition:background .3s\"></span><span style=\"width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer;transition:background .3s\"></span><span style=\"width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer;transition:background .3s\"></span></div></section><section style=\"margin-bottom:2.5rem\"><h2>Welcome</h2><p>บริษัท ไอ อาร์ เอ็ม เอ็กซ์ตร้า จำกัด ก่อตั้งขึ้นเมื่อวันที่ 20 กรกฎาคม 2554 เป็นบริษัทในเครือ IRM ที่ให้บริการด้านบริหารทรัพย์สินอย่างครบวงจร ตั้งแต่งานบริหารอาคาร งานกฎหมาย งานบัญชีการเงิน ไปจนถึงงานวิศวกรรมและซ่อมบำรุง โดยมุ่งเน้นการให้บริการในพื้นที่ภาคอีสาน</p></section><section style=\"margin-bottom:2.5rem\"><h2>จุดเด่นของเรา</h2><div class=\"card-grid\"><div class=\"card\"><h3>30+ ปี</h3><p>ประสบการณ์ของผู้บริหาร</p></div><div class=\"card\"><h3>Professional Team</h3><p>ทีมงานมืออาชีพ</p></div><div class=\"card\"><h3>Legal &amp; Engineering</h3><p>ทีมกฎหมายและวิศวกรรม</p></div><div class=\"card\"><h3>Accounting System</h3><p>ระบบบัญชีและการเงิน</p></div><div class=\"card\"><h3>Fast Response</h3><p>ศูนย์รับเรื่องร้องเรียนและแก้ไขปัญหา</p></div></div></section><section style=\"margin-bottom:2.5rem\"><h2 style=\"text-align:center;margin-bottom:1.5rem\">ทีมผู้บริหาร</h2><div style=\"text-align:center\"><img src=\"/org-chart1.png\" alt=\"ทีมผู้บริหาร IRM Extra\" style=\"max-width:100%;height:auto;border-radius:16px;box-shadow:0 8px 24px rgba(0,0,0,0.15)\"/></div></section><section style=\"margin-bottom:2.5rem\"><h2 style=\"text-align:center;margin-bottom:1.5rem\">ฝ่ายบัญชี IRM Extra</h2><div style=\"text-align:center\"><img src=\"/org-chart2.png\" alt=\"ฝ่ายบัญชี IRM Extra\" style=\"max-width:100%;height:auto;border-radius:16px;box-shadow:0 8px 24px rgba(0,0,0,0.15)\"/></div></section><section style=\"margin-bottom:2.5rem\"><h2 style=\"text-align:center;margin-bottom:1.5rem\">ฝ่ายฝ่ายบุคคล-ธุรการ </h2><div style=\"text-align:center\"><img src=\"/org-chart3.png\" alt=\"ฝ่ายฝ่ายบุคคล-ธุรการ IRM Extra\" style=\"max-width:100%;height:auto;border-radius:16px;box-shadow:0 8px 24px rgba(0,0,0,0.15)\"/></div></section><section style=\"margin-bottom:2.5rem\"><h2 style=\"text-align:center;margin-bottom:1.5rem\">ฝ่ายการเงิน-แจ้งหนี้</h2><div style=\"text-align:center\"><img src=\"/org-chart4.png\" alt=\"ฝ่ายการเงิน-แจ้งหนี้ IRM Extra\" style=\"max-width:100%;height:auto;border-radius:16px;box-shadow:0 8px 24px rgba(0,0,0,0.15)\"/></div></section><section class=\"section-box\" style=\"text-align:center\"><h2>ผลงานของเรา</h2><p>โครงการที่เราดูแลอยู่</p><a class=\"btn\" style=\"margin-top:1rem;display:inline-flex\" href=\"/projects\">ดูผลงานทั้งหมด</a></section></main><footer>IRM EXTRA © <!-- -->2026<!-- --> Premium Property Management Service</footer><script src=\"/_next/static/chunks/webpack-616e068a201ad621.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,\"1:HL[\\\"/_next/static/css/5ed7e8e2458d6db6.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"2:I[2846,[],\\\"\\\"]\\n4:I[9107,[],\\\"ClientPageRoot\\\"]\\n5:I[9215,[\\\"648\\\",\\\"static/chunks/648-485abeac37f81ba6.js\\\",\\\"931\\\",\\\"static/chunks/app/page-bb9c253c1d841d1d.js\\\"],\\\"default\\\",1]\\n6:I[4707,[],\\\"\\\"]\\n7:I[6423,[],\\\"\\\"]\\n9:I[1060,[],\\\"\\\"]\\na:[]\\n0:[\\\"$\\\",\\\"$L2\\\",null,{\\\"buildId\\\":\\\"hoVVtZvOdhVqNh0Brh3Nt\\\",\\\"assetPrefix\\\":\\\"\\\",\\\"urlParts\\\":[\\\"\\\",\\\"\\\"],\\\"initialTree\\\":[\\\"\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]},\\\"$undefined\\\",\\\"$undefined\\\",true],\\\"initialSeedData\\\":[\\\"\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{},[[\\\"$L3\\\",[\\\"$\\\",\\\"$L4\\\",null,{\\\"props\\\":{\\\"params\\\":{},\\\"searchParams\\\":{}},\\\"Component\\\":\\\"$5\